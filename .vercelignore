# Vercel deployment excludes — keeps function bundle small
.venv/
venv/

# Force Vercel to use requirements.txt (not uv.lock which installs mlx/torch/325MB)
pyproject.toml
uv.lock

# Local model files (not used in cloud)
mlx_models/
mlx-community/

# Large FHIR data directories
generations/

# Development notebooks
*.ipynb
.ipynb_checkpoints/

# Frontend source — only dist/ is needed (served by server.py StaticFiles)
frontend/node_modules/
frontend/src/
frontend/public/
frontend/.gitignore
frontend/eslint.config.js
frontend/tsconfig*.json
frontend/env.d.ts
frontend/index.html
frontend/package*.json
frontend/vite.config.mts

# Secrets (Vercel env vars used instead)
.env
