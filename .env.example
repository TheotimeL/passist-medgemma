# Copy this to .env and fill in your values

# Hugging Face token (needed for model download on first run)
HF_TOKEN=your_huggingface_token_here

# Google AI API key (needed for Gemini backend or policy extraction)
LANGEXTRACT_API_KEY=your_google_api_key_here

# Backend: "mlx" (default, Apple Silicon) or "gemini" (Google Cloud)
# EXTRACTION_BACKEND=gemini

# Set to 1 to skip loading the model (uses pre-computed results only)
# SKIP_MODEL=1

# Production frontend URL (used for CORS when hosting)
# FRONTEND_URL=https://your-app.run.app
