# Copy this to .env and fill in your values
HF_TOKEN=your_huggingface_token_here

# Google AI / LangExtract API key (required for Gemini backend)
LANGEXTRACT_API_KEY=your_google_api_key_here

# Backend: "mlx" (default, Apple Silicon) or "gemini" (cloud)
# EXTRACTION_BACKEND=gemini

# Set to 1 to skip model loading entirely (pre-computed results only)
# SKIP_MODEL=1

# Production frontend URL (used for CORS when hosting)
# FRONTEND_URL=https://your-app.run.app
